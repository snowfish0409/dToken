# dToken Provider Service Node environment
# Copy this file to `.env`, fill the placeholders, then run:
#   npm run config:check
#   npm run upstream:check

DTOKEN_PROVIDER_CONFIG=./config/production.json
DTOKEN_PUBLIC_BASE_URL=http://YOUR_SERVER_IP_OR_DOMAIN:8788/v1
DTOKEN_PORT=8788

# Ethereum mainnet RPC. Public RPC is fine for a first smoke test; use a
# dedicated paid RPC for production reliability.
DTOKEN_CONTRACT_RPC=https://ethereum-rpc.publicnode.com

# Provider wallet. This wallet announces models and receives dToken settlement.
DTOKEN_PROVIDER_WALLET=0xYourProviderWallet
DTOKEN_PROVIDER_PRIVATE_KEY=0xYourProviderPrivateKey

# First deployment can reuse the Provider wallet as service signer.
# For production, you may use a separate wallet and add it to provider identities
# if the protocol flow requires that separation.
DTOKEN_SERVICE_SIGNER_ADDRESS=0xYourProviderWallet
DTOKEN_SERVICE_SIGNER_KEY=0xYourProviderPrivateKey

# Qwen Token Plan API key from the Token Plan console.
# The token-plan Base URL is configured by the existing qwen_coding_plan
# adapter entry in apps/reseller-agent/config/production.template.json.
DTOKEN_UPSTREAM_QWEN_KEY=YOUR_QWEN_TOKEN_PLAN_API_KEY
